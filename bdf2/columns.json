      "datetime_formats": [
        "%m/%d/%Y %H:%M:%S.%f",
        "%m/%d/%Y %H:%M:%S",
        "%Y-%m-%d %H:%M:%S"
      ],
      "metadata_patterns": {}
    },
    "maccor_csv": {
      "exts": [".csv"],
      "magic": ["today's date", "date of test:"],
