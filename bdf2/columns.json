  "sources": {
    "basytec_txt": {
      "exts": [".txt", ".dat"],
      "magic": ["resultfile from basytec battery test system", "basytec battery test system"],
      "qty_unit_regexes": ["^~?([A-Za-z][A-Za-z0-9_-]*)\\[([^\\]]+)\\]$"],
      "datetime_formats": ["%d.%m.%Y %H:%M:%S"],
      "metadata_patterns": {
        "start_datetime": "~Start of Test:\\s*(.+)",
        "end_datetime":   "~End of Test:\\s*(.+)",
        "channel":        "~Testchannel:\\s*(.+)",
        "testplan":       "~Testplan:\\s*(.+)"
      }
    },
    "biologic_mpt": {
      "exts": [".mpt"],
      "magic": ["bt-lab ascii file", "ec-lab ascii file"],
      "qty_unit_regexes": [
        "^<(.+?)>/(.+)$",
        "^(.+?)\\s*/\\s*(.+)$"
      ],
      "datetime_formats": ["%m/%d/%Y %H:%M:%S.%f", "%m/%d/%Y %H:%M:%S"],
      "metadata_patterns": {
        "acquisition_started": "Acquisition started on\\s*:\\s*(.+)",
        "channel":             "Run on channel\\s*:\\s*(.+)"
      }
    },
    "neware_csv": {
      "exts": [".csv"],
      "magic": [],
      "qty_unit_regexes": [
        "^(.+?)\\s*\\(([^)]+)\\)$",
        "^(.+?)\\s*\\[([^\\]]+)\\]$"
      ],
      "datetime_formats": [
        "%Y-%m-%d %H:%M:%S.%f",
        "%Y-%m-%d %H:%M:%S",
        "%Y/%m/%d %H:%M:%S"
      ],
      "metadata_patterns": {}
    },
    "novonix_csv": {
      "exts": [".csv"],
      "magic": ["[summary]", "[data]", "novonix uhpc data file", "novonix"],
      "qty_unit_regexes": ["^(.+?)\\s*\\(([^)]+)\\)$"],
      "datetime_formats": ["%Y-%m-%d %H:%M:%S"],
      "metadata_patterns": {
        "channel": "Channel:\\s*(.+)"
      }
    },
    "digatron_csv": {
      "exts": [".csv"],
      "magic": [],
      "qty_unit_regexes": ["^(.+?)#(.+)$"],
      "datetime_formats": ["%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S"],
      "metadata_patterns": {}
    },
    "landt_csv": {
      "exts": [".csv"],
      "magic": [],
      "qty_unit_regexes": ["^(.+)_([a-z]{1,3})$"],
      "datetime_formats": [],
      "metadata_patterns": {}
    },
    "landt_txt": {
      "exts": [".txt"],
      "magic": [],
      "qty_unit_regexes": ["^(.+?)\\s*\\(([^)]+)\\)$"],
      "datetime_formats": [],
      "metadata_patterns": {}
    },
    "arbin_csv": {
