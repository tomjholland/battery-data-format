        "%d-%b-%y %I:%M:%S %p",
        "%d-%b-%y %H:%M:%S",
        "%Y-%m-%d %H:%M:%S"
      ],
      "metadata_patterns": {
        "test_date":   "Date of Test:,(.+)",
        "today_date":  "Today's Date\\s*,(.+)"
      }
    }
